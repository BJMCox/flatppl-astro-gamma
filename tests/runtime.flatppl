%%%
# Compiled value, derivative, and batching contract

x = [amplitude, index, curvature, cutoff_energy, cutoff_power,
     ebl_scale, energy_scale]. Index 1 exercises BOTH integral logarithmic limits:
photon integral at index and energy integral at index + 1.
%%%
flatppl_compat = "0.1"
a = load_module("../main.flatppl")
x = elementof(cartpow(reals, 7))
flux = a.powerlaw.([0.5, 1.0, 2.0], x[1], x[2], 1.3)
attenuated = flux .* a.ebl_transmission.([0.05, 0.2, 0.5], x[6])
source = a.fold_spectrum(
  rowstack([[0.7, 0.2, 0.0], [0.1, 0.6, 0.7]]),
  [1.0, 2.0, 3.0],
  attenuated,
  [0.5, 0.75, 1.0],
  4.0,
)
outputs = [
  a.powerlaw(2.0, x[1], x[2], 1.3),
  a.logparabola(2.0, x[1], x[2], x[3], 1.3),
  a.cutoff_powerlaw(2.0, x[1], x[2], x[4], x[5], 1.3),
  a.powerlaw_photon_integral(0.4, 5.0, x[1], x[2], 1.3),
  a.powerlaw_energy_integral(0.4, 5.0, x[1], x[2] + 1, 1.3),
  a.ebl_transmission(0.7, x[6]),
  source[1],
  source[2],
  a.migration_density_to_energy_density(2.0, x[4]),
  a.energy_scale_density(0.5, x[7]),
]
inputs = x
